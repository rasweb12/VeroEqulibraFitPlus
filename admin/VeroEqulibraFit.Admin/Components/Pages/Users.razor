@page "/usuarios"
@inject AdminApiSession Session
@inject NavigationManager Navigation
<PageTitle>Usuários · Administração</PageTitle>
<h1>Usuários</h1>
<p class="text-muted">Apenas identidade e estado operacional. Dados de saúde e conversas privadas não são exibidos.</p>
@if (_error is not null) { <div class="alert alert-warning">@_error</div> }
<div class="row g-2 mb-3"><div class="col-md-5"><label for="search">Nome ou e-mail</label><input id="search" class="form-control" @bind="_search" /></div><div class="col-md-3"><label for="status">Status</label><select id="status" class="form-select" @bind="_status"><option value="all">Todos</option><option value="active">Ativos</option><option value="blocked">Bloqueados</option></select></div><div class="col-md-3"><label for="role">Papel</label><select id="role" class="form-select" @bind="_role"><option value="">Todos</option>@foreach (var role in _roles) { <option value="@role.Name">@role.Name</option> }</select></div><div class="col-md-1 align-self-end"><button class="btn btn-primary w-100" @onclick="FilterAsync" disabled="@_busy">Filtrar</button></div></div>
@if (_page is null) { <p role="status">Carregando…</p> } else { <p><strong>@_page.TotalCount</strong> conta(s).</p><div class="table-responsive"><table class="table"><thead><tr><th>Conta</th><th>Status</th><th>Papéis</th><th>Cadastro</th><th></th></tr></thead><tbody>@if (_page.Items.Count == 0) { <tr><td colspan="5" class="text-muted">Nenhuma conta encontrada.</td></tr> } @foreach(var user in _page.Items) { <tr><td><strong>@(user.DisplayName ?? "Sem nome")</strong><br/><small>@user.Email</small></td><td><span class="badge @(user.IsBlocked ? "text-bg-danger" : "text-bg-success")">@(user.IsBlocked ? "Bloqueada" : "Ativa")</span></td><td>@(user.Roles.Count == 0 ? "Sem papel" : string.Join(", ",user.Roles))</td><td>@Format(user.RegisteredAt)</td><td><a class="btn btn-sm btn-outline-primary" href="@($"/usuarios/{user.Id}")">Consultar</a></td></tr>}</tbody></table></div><button class="btn btn-outline-secondary me-2" disabled="@(_busy || _page.Page <= 1)" @onclick="PreviousAsync">Anterior</button><span>Página @_page.Page de @Pages</span><button class="btn btn-outline-secondary ms-2" disabled="@(_busy || _page.Page >= Pages)" @onclick="NextAsync">Próxima</button>}
@code { private AdminUserPage? _page; private IReadOnlyList<AdminRole> _roles=[]; private string _search="",_status="all",_role=""; private string? _error; private bool _busy; private int Pages=>_page is null?1:Math.Max(1,(int)Math.Ceiling((double)_page.TotalCount/_page.PageSize)); protected override async Task OnInitializedAsync(){if(!Session.IsAuthenticated){Navigation.NavigateTo("/entrar");return;} _roles=await Session.GetRolesAsync();await LoadAsync(1);} private Task FilterAsync()=>LoadAsync(1); private Task PreviousAsync()=>LoadAsync(_page!.Page-1); private Task NextAsync()=>LoadAsync(_page!.Page+1); private async Task LoadAsync(int page){_busy=true;_error=null;try{var result=await Session.ListUsersAsync(page,_search,_status,_role);_page=result.Page;_error=result.Error;}finally{_busy=false;}} private static string Format(DateTimeOffset? date)=>date?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"Não registrado"; }
