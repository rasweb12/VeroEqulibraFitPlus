@page "/catalogo/exercicios/novo"
@page "/catalogo/exercicios/{Id}"
@rendermode InteractiveServer
@inject VeroEqulibraFit.Admin.Services.AdminApiSession Session
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "Novo exercício" : "Editar exercício")</PageTitle>
<h1>@(_isNew ? "Novo exercício" : "Editar exercício")</h1>
<p class="text-muted">A publicação altera somente o catálogo global. O histórico de treinos permanece preservado.</p>
@if (_error is not null) { <div class="alert alert-warning">@_error</div> }
@if (_busy) { <p>Carregando…</p> }
else { <EditForm Model="_form" OnValidSubmit="SaveAsync"><DataAnnotationsValidator/><ValidationSummary/>
<div class="card p-3 mb-3"><div class="row g-3"><div class="col-md-4"><label class="form-label">ID estável</label><InputText class="form-control" @bind-Value="_form.Id" disabled="@(!_isNew)"/><small class="text-muted">Minúsculas, números e hífen.</small></div><div class="col-md-8"><label class="form-label">Nome</label><InputText class="form-control" @bind-Value="_form.Name"/></div><div class="col-md-6"><label class="form-label">Grupo muscular</label><InputText class="form-control" @bind-Value="_form.PrimaryMuscle"/></div><div class="col-md-6"><label class="form-label">Equipamento</label><InputText class="form-control" @bind-Value="_form.Equipment"/></div><div class="col-12"><label class="form-label">Instruções</label><InputTextArea class="form-control" @bind-Value="_form.Instructions" rows="5"/></div><div class="col-12 form-check ms-2"><InputCheckbox class="form-check-input" @bind-Value="_form.IsPublished"/><label class="form-check-label">Publicado no catálogo</label></div></div></div>
<div class="card p-3"><label class="form-label">Justificativa administrativa</label><InputText class="form-control" @bind-Value="_form.Reason"/><div class="form-check mt-2"><InputCheckbox class="form-check-input" @bind-Value="_form.Confirmed"/><label class="form-check-label">Confirmo a alteração deste conteúdo global.</label></div><div class="mt-3"><button class="btn btn-primary" disabled="@_saving">@(_saving ? "Salvando…" : "Salvar exercício")</button><button type="button" class="btn btn-link" @onclick='() => Navigation.NavigateTo("/catalogo/exercicios")'>Voltar</button></div></div></EditForm>
@if (!_isNew) { <section class="mt-4"><h2 class="h4">Demonstrações associadas</h2>@if (_media.Count == 0) { <p class="text-muted">Nenhuma demonstração associada.</p> } else { <ul class="list-group">@foreach (var media in _media) { <li class="list-group-item d-flex justify-content-between"><span>@media.AssetPath @if(media.IsPrimary){<span class="badge text-bg-success">Principal</span>}</span><small>@media.Label</small></li>}</ul> }
<div class="card p-3 mt-3"><h3 class="h5">Associar vídeo original</h3>@if (_assets.Count == 0) { <p class="text-muted">Carregando inventário de vídeos…</p> } else { <div class="row g-2"><div class="col-md-7"><select class="form-select" @bind="_mediaForm.AssetPath"><option value="">Selecione um arquivo do inventário</option>@foreach(var asset in _assets){<option value="@asset">@asset</option>}</select></div><div class="col-md-3"><input class="form-control" @bind="_mediaForm.Label" placeholder="Rótulo opcional" /></div><div class="col-md-2 form-check pt-2"><input class="form-check-input" type="checkbox" @bind="_mediaForm.IsPrimary"/><label class="form-check-label">Principal</label></div><div class="col-md-9"><input class="form-control" @bind="_mediaForm.Reason" placeholder="Justificativa administrativa" /></div><div class="col-md-3 form-check pt-2"><input class="form-check-input" type="checkbox" @bind="_mediaForm.Confirmed"/><label class="form-check-label">Confirmo</label></div></div><button class="btn btn-outline-primary mt-3" disabled="@_savingMedia" @onclick="SaveMediaAsync">@(_savingMedia ? "Associando…" : "Associar vídeo")</button> }<button class="btn btn-link mt-3" @onclick='() => Navigation.NavigateTo("/catalogo/midias")'>Ver inventário</button></div></section> }
}

@code {
    [Parameter] public string? Id { get; set; }
    private readonly ExerciseForm _form = new(); private readonly MediaForm _mediaForm = new(); private IReadOnlyList<AdminCatalogMediaItem> _media = []; private IReadOnlyList<string> _assets = []; private string? _error; private bool _busy, _saving, _savingMedia;
    private bool _isNew => string.IsNullOrWhiteSpace(Id) || string.Equals(Id, "novo", StringComparison.OrdinalIgnoreCase);
    protected override async Task OnParametersSetAsync() { if (!Session.IsAuthenticated) { Navigation.NavigateTo("/entrar"); return; } if (_isNew) return; _busy = true; _error = null; try { var detailTask = Session.GetCatalogExerciseAsync(Id!); var inventoryTask = Session.GetMediaInventoryAsync(); await Task.WhenAll(detailTask, inventoryTask); var result = await detailTask; var inventory = await inventoryTask; _error = result.Error ?? inventory.Error; _assets = inventory.Inventory?.RegisteredAssets ?? []; if (result.Exercise is not null) { _form.Id = result.Exercise.Id; _form.Name = result.Exercise.Name; _form.PrimaryMuscle = result.Exercise.PrimaryMuscle; _form.Equipment = result.Exercise.Equipment; _form.Instructions = result.Exercise.Instructions; _form.IsPublished = result.Exercise.IsPublished; _media = result.Exercise.Media; } } finally { _busy = false; } }
    private async Task SaveAsync() { _saving = true; _error = null; try { var id = _form.Id.Trim(); var request = new SaveAdminCatalogExerciseRequest(id, _form.Name, _form.PrimaryMuscle, _form.Equipment, _form.Instructions, _form.IsPublished, _form.Reason, _form.Confirmed); var result = await Session.SaveCatalogExerciseAsync(id, request); _error = result.Error; if (result.Exercise is not null) Navigation.NavigateTo($"/catalogo/exercicios/{result.Exercise.Id}"); } finally { _saving = false; } }
    private async Task SaveMediaAsync() { _savingMedia = true; _error = null; try { var request = new SaveAdminCatalogMediaRequest(_mediaForm.AssetPath, _mediaForm.Label, _mediaForm.IsPrimary, _mediaForm.Reason, _mediaForm.Confirmed); var result = await Session.SaveCatalogMediaAsync(Id!, Guid.Empty, request); _error = result.Error; if (result.Exercise is not null) { _media = result.Exercise.Media; _mediaForm.Reset(); } } finally { _savingMedia = false; } }
    private sealed class ExerciseForm { [System.ComponentModel.DataAnnotations.Required] public string Id { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string Name { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string PrimaryMuscle { get; set; } = ""; [System.ComponentModel.DataAnnotations.Required] public string Equipment { get; set; } = ""; public string Instructions { get; set; } = ""; public bool IsPublished { get; set; } = true; [System.ComponentModel.DataAnnotations.Required] public string Reason { get; set; } = ""; public bool Confirmed { get; set; } }
    private sealed class MediaForm { public string AssetPath { get; set; } = ""; public string? Label { get; set; } public bool IsPrimary { get; set; } = true; public string Reason { get; set; } = ""; public bool Confirmed { get; set; } public void Reset() { AssetPath = ""; Label = null; IsPrimary = true; Reason = ""; Confirmed = false; } }
}
