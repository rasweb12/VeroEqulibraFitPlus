@page "/usuarios/{Id:guid}"
@rendermode InteractiveServer
@inject AdminApiSession Session
@inject NavigationManager Navigation
<p><a href="/usuarios">← Voltar aos usuários</a></p>
@if(_error is not null){<div class="alert alert-warning">@_error</div>} else if(_user is null){<p>Carregando…</p>} else {<h1>@(_user.DisplayName??"Sem nome de exibição")</h1><section class="card p-3 mb-3"><dl class="row mb-0"><dt class="col-sm-3">E-mail</dt><dd class="col-sm-9">@_user.Email</dd><dt class="col-sm-3">ID</dt><dd class="col-sm-9 font-monospace small">@_user.Id</dd><dt class="col-sm-3">Cadastro</dt><dd class="col-sm-9">@F(_user.RegisteredAt)</dd><dt class="col-sm-3">Último acesso</dt><dd class="col-sm-9">@F(_user.LastAccessAt)</dd></dl></section><section class="card p-3 mb-3"><h2 class="h4">Status da conta</h2><p class="small text-muted">Bloquear encerra as sessões existentes. Exige justificativa e confirmação.</p><select class="form-select mb-2" @bind="_status"><option value="active">Ativa</option><option value="blocked">Bloqueada</option></select><input class="form-control mb-2" placeholder="Justificativa" @bind="_statusReason"/><div class="form-check mb-2"><input id="confirm-status" class="form-check-input" type="checkbox" @bind="_statusConfirmed"/><label for="confirm-status">Confirmo a alteração.</label></div><button class="btn btn-danger" disabled="@_busy" @onclick="SaveStatusAsync">Salvar status</button></section><section class="card p-3 mb-3"><h2 class="h4">Papéis</h2>@foreach(var role in _roles){<div class="form-check"><input id="role-@role.Name" class="form-check-input" type="checkbox" checked="@_selected.Contains(role.Name)" @onchange="e=>Toggle(role.Name,e.Value)"/><label for="role-@role.Name">@role.Name</label></div>}<input class="form-control my-2" placeholder="Justificativa" @bind="_rolesReason"/><div class="form-check mb-2"><input id="confirm-roles" class="form-check-input" type="checkbox" @bind="_rolesConfirmed"/><label for="confirm-roles">Confirmo a alteração.</label></div><button class="btn btn-primary" disabled="@_busy" @onclick="SaveRolesAsync">Salvar papéis</button></section><section class="card p-3"><h2 class="h4">Histórico administrativo</h2>@if(_user.AuditEvents.Count==0){<p class="text-muted mb-0">Nenhuma ação registrada.</p>}else{<ul class="list-group list-group-flush">@foreach(var a in _user.AuditEvents){<li class="list-group-item px-0"><strong>@a.Action</strong> · @a.Result<br/><small>@F(a.OccurredAt) · operador @a.ActorUserId</small>@if(!string.IsNullOrWhiteSpace(a.Reason)){<br/><small>@a.Reason</small>}</li>}</ul>}</section>}
@code {[Parameter]public Guid Id{get;set;} private AdminUserDetail? _user;private IReadOnlyList<AdminRole> _roles=[];private HashSet<string> _selected=new(StringComparer.OrdinalIgnoreCase);private string _status="active",_statusReason="",_rolesReason="";private bool _statusConfirmed,_rolesConfirmed,_busy;private string? _error;protected override async Task OnParametersSetAsync(){if(!Session.IsAuthenticated){Navigation.NavigateTo("/entrar");return;}await ReloadAsync();}private async Task ReloadAsync(){_busy=true;try{var r=await Session.GetUserAsync(Id);_user=r.User;_error=r.Error;_roles=await Session.GetRolesAsync();if(_user is not null){_selected=_user.Roles.ToHashSet(StringComparer.OrdinalIgnoreCase);_status=_user.IsBlocked?"blocked":"active";}}finally{_busy=false;}}private void Toggle(string role,object? value){if(value is bool yes&&yes)_selected.Add(role);else _selected.Remove(role);}private async Task SaveStatusAsync(){if(_user is null)return;_busy=true;_error=await Session.ChangeUserStatusAsync(Id,_status,_statusReason,_statusConfirmed);_busy=false;if(_error is null)await ReloadAsync();}private async Task SaveRolesAsync(){if(_user is null)return;_busy=true;_error=await Session.ChangeUserRolesAsync(Id,_selected.ToList(),_rolesReason,_rolesConfirmed);_busy=false;if(_error is null)await ReloadAsync();}private static string F(DateTimeOffset? date)=>date?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"Não registrado";}
