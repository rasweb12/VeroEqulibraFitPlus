@inject VeroEqulibraFit.Admin.Services.AdminApiSession Session
@inject NavigationManager Navigation
@implements IDisposable

<div class="brand"><span class="brand-mark">V</span><span>VeroEquilibraFit+<small>Administração</small></span></div>
@if (Session.IsAuthenticated)
{
    <div class="session-state" role="status"><span aria-hidden="true">●</span> Sessão administrativa</div>
}
<input type="checkbox" title="Abrir navegação" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav aria-label="Navegação administrativa">
        <p class="nav-caption">PAINEL</p>
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><span>▦</span> Visão geral</NavLink>
        @if (Session.IsAuthenticated)
        {
            <p class="nav-caption">GESTÃO</p>
            <NavLink class="nav-link" href="usuarios"><span>◉</span> Usuários</NavLink>
            <p class="nav-caption">CATÁLOGO</p>
            <NavLink class="nav-link" href="catalogo/exercicios"><span>⌁</span> Exercícios</NavLink>
            <NavLink class="nav-link" href="catalogo/midias"><span>▷</span> Mídias e demonstrações</NavLink>
            <p class="nav-caption">OPERAÇÃO</p>
            <span class="nav-link unavailable"><span>▤</span> Conteúdos e planos <small>indisponível</small></span>
            <span class="nav-link unavailable"><span>◷</span> Auditoria <small>indisponível</small></span>
            <span class="nav-link unavailable"><span>⚙</span> Serviços e configurações <small>indisponível</small></span>
            <div class="nav-divider"></div>
            <button type="button" class="nav-link signout" @onclick="SignOut"><span>↪</span> Sair</button>
        }
        else
        {
            <div class="nav-divider"></div>
            <NavLink class="nav-link" href="entrar"><span>→</span> Entrar</NavLink>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private async Task SignOut()
    {
        await Session.SignOutAsync();
        Navigation.NavigateTo("/entrar", forceLoad: true);
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
