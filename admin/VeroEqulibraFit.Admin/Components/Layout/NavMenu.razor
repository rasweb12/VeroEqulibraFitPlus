@inject VeroEqulibraFit.Admin.Services.AdminApiSession Session
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VeroEqulibraFit+ Admin</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-shield-lock-fill-nav-menu" aria-hidden="true"></span> Operação
            </NavLink>
        </div>
        @if (Session.IsAuthenticated)
        {
            <div class="nav-item px-3">
                <button type="button" class="nav-link" @onclick="SignOut">
                    <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Sair
                </button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="entrar">
                    <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Entrar
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private void SignOut()
    {
        Session.SignOut();
        Navigation.NavigateTo("/entrar", forceLoad: true);
    }
}
